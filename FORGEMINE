let tab='mine';
$('nav').innerHTML=TABS.map(t=>`<button data-t="${t[0]}"><svg viewBox="0 0 24 24">${NAVI[t[0]]}</svg>${t[1]}</button>`).join('');
$('nav').onclick=e=>{const b=e.target.closest('button');if(b){tab=b.dataset.t;view()}};

function view(){
 document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.t===tab));
 let h='';
 if(tab==='mine'){const nc=Math.floor(Math.sqrt(S.total/1e4)),can=S.total>=1e5&&nc>S.cr;
  const own=M.filter(m=>S.lv[m.id]>0);
  h=`<div class="card"><div class="orbw"><div class="halo"></div>
  <svg class="ring r1" viewBox="0 0 200 200"><circle cx="100" cy="100" r="96" fill="none" stroke="url(#rg)" stroke-width="2" stroke-dasharray="3 11" stroke-linecap="round"/></svg>
  <svg class="ring r2" viewBox="0 0 200 200"><circle cx="100" cy="100" r="96" fill="none" stroke="url(#rg)" stroke-width="1.5" stroke-dasharray="40 14" opacity=".6"/></svg>
  <button class="orb" id="orb" aria-label="Minar">${PICK}</button></div>
  <div class="row" style="justify-content:center">+<b id="cpw" style="color:var(--g)"></b> por toque</div></div>
  <div class="card"><h3>Tu sala de máquinas</h3><div class="plant">${own.length?own.map(m=>`<div class="tile" style="animation-delay:${Math.random()*2}s">${ic(m.id,m.a,m.z,46)}<em>${S.lv[m.id]}</em></div>`).join(''):'<span class="row">Compra tu primer minero en la pestaña Mineros</span>'}</div></div>
  <div class="card"><h3>Producción en vivo</h3><canvas class="cv" id="cv"></canvas></div>
  <div class="card claim"><svg width="84" height="84" viewBox="0 0 84 84"><circle cx="42" cy="42" r="34" fill="none" stroke="rgba(0,0,0,.3)" stroke-width="8"/><circle id="ringp" cx="42" cy="42" r="34" fill="none" stroke="url(#rg)" stroke-width="8" stroke-linecap="round" stroke-dasharray="213.6" stroke-dashoffset="213.6" transform="rotate(-90 42 42)" style="transition:stroke-dashoffset .5s"/><text id="ringt" x="42" y="47" text-anchor="middle" fill="currentColor" font-size="15" font-weight="800">0%</text></svg>
  <div class="t"><div class="row"><span>$FORGE acumulado</span></div><b id="pend" style="font-size:22px"></b><div class="row" id="eco" style="flex-wrap:wrap"></div>
  <button class="btn g" id="claim" style="width:100%;margin-top:8px"></button></div></div>
  <div class="card it"><div class="ico" style="font-size:30px">👥</div><div class="t"><b>Invita a tus Amigos</b><span>Gana un 10% extra por cada amigo invitado a la Mini App.</span></div><button class="btn" id="inviteBtn">Invitar</button></div>`}
 if(tab==='miners')h=`<div class="q">${[1,10,25].map(n=>`<button data-q="${n}" class="${q===n?'on':''}">x${n}</button>`).join('')}</div>`+M.map((m,i)=>{
  const l=S.lv[m.id],nx=HITOS.find(x=>x>l),pv=[0].concat(HITOS).filter(x=>x<=l).pop(),pc=nx?(l-pv)/(nx-pv)*100:100;
  return `<div class="card" style="animation-delay:${i*.04}s;border-left:3px solid ${RC[m.rar]}"><div class="it"><div class="ico">${ic(m.id,m.a,m.z,52)}</div>
  <div class="t"><span class="rar" style="color:${RC[m.rar]}">${m.rar}</span><b>${m.n} · Nv ${l}</b><span>+${fmt(m.r*mm(m)*gm())}/s por nivel</span></div>
  <button class="btn" data-m="${m.id}" data-cost="${bulk(m)}">${fmt(bulk(m))}</button></div>
  <div class="bar"><i style="width:${pc}%"></i></div></div>`}).join('');
 if(tab==='ups')h=UP.map((u,i)=>`<div class="card it" style="animation-delay:${i*.04}s"><div class="ico" style="font-size:28px;width:48px;height:48px;border-radius:13px;background:var(--card2);border:1px solid var(--line)">${u.k}</div><div class="t"><b>${u.n}</b><span>${u.d}</span></div>
  ${S.up[u.id]?'<span class="tag">Activa</span>':`<button class="btn" data-u="${u.id}" data-cost="${u.c}">${fmt(u.c)}</button>`}</div>`).join('');
 if(tab==='ms')h=MI.map(m=>{const p=Math.min(prog(m.k),m.g),d=p>=m.g,c=S.ms[m.id];
  return `<div class="card"><div class="it"><div class="t"><b>${m.n}</b><span>Recompensa: ${m.rw} $FORGE</span></div>
  <button class="btn g" data-ms="${m.id}" ${d&&!c?'':'disabled'}>${c?'Reclamada ✓':'Reclamar'}</button></div>
  <div class="bar"><i style="width:${p/m.g*100}%"></i></div></div>`}).join('');
 if(tab==='rk'){
  const tgUser = tg && tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user.first_name : (S.wallet ? short(S.wallet) : 'Tú');
  const me=S.total,L=BOTS.map((n,i)=>({n,s:Math.max(me*(1.6-i*.16),500*(9-i))})).concat([{n:tgUser,s:me,me:1}]).sort((a,b)=>b.s-a.s);
  h=`<div class="card">${L.map((x,i)=>`<div class="rk ${x.me?'me':''}"><em>${i+1}</em><span>${x.n}</span><b>${fmt(x.s)}</b></div>`).join('')}</div>`}
 if(tab==='tk'){
  h=`<div class="card"><h3>Comunidad Oficial</h3>
  <div class="soc-btn">
    <a href="https://t.me/ForgeMineChannel" target="_blank">Canal de Telegram</a>
    <a href="https://x.com" target="_blank">Twitter / X</a>
  </div></div>
  <div class="card leg"><div>⚡ <b>Puntos de Airdrop</b> convertibles a $FORGEMINE en el TGE.</div><div>📉 Suministro fijo y quema automática de tokens.</div></div>`}
 $('view').innerHTML=h;upd();afford();
}
let dB=S.bal;
function upd(){
 $('rate').textContent=fmt(rate());$('mult').textContent='x'+gm().toFixed(2);$('cr').textContent=S.cr;
 $('wallet').textContent=S.wallet?short(S.wallet):'Billetera';
 if(tab==='mine'){$('cpw').textContent=fmt(cp());$('pend').textContent=fmt(S.pend);
  const p=Math.min(S.pend/MINC,1);$('ringp').style.strokeDashoffset=213.6*(1-p);$('ringt').textContent=Math.floor(p*100)+'%';
  $('claim').textContent='Guardar Puntos Airdrop';$('eco').innerHTML='<span>Hoy '+fmt(S.claimed)+'/'+CAP+'</span><span>🔥 '+fmt(S.burned)+'</span>';draw()}
}
function draw(){const c=$('cv');if(!c)return;const d=devicePixelRatio||1,w=c.clientWidth*d,h=c.clientHeight*d;if(c.width!==w){c.width=w;c.height=h}
 const x=c.getContext('2d');x.clearRect(0,0,w,h);x.strokeStyle='rgba(150,144,192,.15)';x.lineWidth=1;for(let i=1;i<4;i++){x.beginPath();x.moveTo(0,h*i/4);x.lineTo(w,h*i/4);x.stroke()}
 const a=S.hist;if(a.length<2)return;const mx=Math.max(...a,1)*1.1,P=a.map((v,i)=>[i/(a.length-1)*w,h-6*d-v/mx*(h-14*d)]);
 const gr=x.createLinearGradient(0,0,0,h);gr.addColorStop(0,'rgba(153,69,255,.55)');gr.addColorStop(1,'rgba(153,69,255,0)');
 x.beginPath();P.forEach((p,i)=>i?x.lineTo(p[0],p[1]):x.moveTo(p[0],p[1]));x.lineTo(w,h);x.lineTo(0,h);x.fillStyle=gr;x.fill();
 x.beginPath();P.forEach((p,i)=>i?x.lineTo(p[0],p[1]):x.moveTo(p[0],p[1]));x.strokeStyle='#14f195';x.lineWidth=2.5*d;x.stroke()}

document.addEventListener('click',e=>{const t=e.target;
 if(t.closest('#orb')){const g=cp();add(g);S.clicks++;upd();afford();return}
 let b=t.closest('[data-q]');if(b){q=+b.dataset.q;view();return}
 b=t.closest('[data-m]');if(b){const m=M.find(x=>x.id===b.dataset.m),c=bulk(m);if(S.bal>=c){S.bal-=c;S.lv[m.id]+=q;view();save()}return}
 b=t.closest('[data-u]');if(b){const u=UP.find(x=>x.id===b.dataset.u);if(S.bal>=u.c){S.bal-=u.c;S.up[u.id]=1;toast('✅ '+u.n);view();save()}return}
 b=t.closest('#inviteBtn');if(b){
   const shareUrl = "https://t.me/share/url?url=https://t.me/ForgeMineBot&text=¡Únete a ForgeMine y mina $FORGEMINE en Solana!";
   if(tg) tg.openTelegramLink(shareUrl); else window.open(shareUrl, '_blank');
   return;
 }
});
$('wallet').onclick=async()=>{
 const p=(window.phantom&&window.phantom.solana)||window.solana;
 if(p&&p.isPhantom){try{const r=await p.connect();S.wallet=r.publicKey.toString();toast('Billetera Conectada');view();save()}catch(e){}}
 else{toast('Instala Phantom Wallet para conectar')}
};
setInterval(()=>{add(rate());S.hist.push(rate());if(S.hist.length>60)S.hist.shift();upd();afford();save()},1000);
(function loop(){dB+=(S.bal-dB)*.18;if(Math.abs(S.bal-dB)<.05)dB=S.bal;$('bal').textContent=fmt(dB);requestAnimationFrame(loop)})();
view();
</script></body></html>
